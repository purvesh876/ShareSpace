# ==============================================================================
# ShareSpace Backend Environment Configuration Example
# Copy this file to backend/.env in local development. Never commit real secrets!
# ==============================================================================

# --- Application Metadata ---
APP_NAME="ShareSpace API"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Development fallback secret key. In production, this must be a strong random secret.
SECRET_KEY="replace-this-with-a-random-secure-secret-key-in-production"

# --- Supabase Authentication & JWT Verification ---
# Match these settings to your Supabase Project Settings -> API / Auth configuration:
#
# 1. Supabase Project URL (e.g. https://[YOUR-PROJECT-REF].supabase.co):
#    Required for validating issuer claims and resolving JWKS asymmetric public keys.
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# 2. JWT Verification Algorithms (Allowlist):
#    Modern Supabase projects sign user JWTs using asymmetric ECC (ES256).
#    The backend fetches the public key dynamically from the project JWKS endpoint.
#    Legacy projects using symmetric HMAC SHA-256 (HS256) require SUPABASE_JWT_SECRET.
JWT_ALGORITHMS="ES256,HS256"
JWT_ALGORITHM="ES256"

# 3. For Legacy HS256: Supabase JWT Secret (Dashboard -> Settings -> API -> JWT Secret)
#    Required in production ONLY when verifying legacy symmetric HS256 tokens.
#    Not needed for ES256/ECC tokens (which are verified via JWKS).
# SUPABASE_JWT_SECRET="replace-with-your-supabase-jwt-secret-from-dashboard"

# 4. For RS256/ES256 Static Override (Optional Alternative to JWKS):
#    PEM-encoded public key string if not resolving keys dynamically from JWKS.
# SUPABASE_JWT_PUBLIC_KEY=""

# 5. Expected JWT Claims:
JWT_AUDIENCE="authenticated"
# Optional explicit issuer (defaults to ${SUPABASE_URL}/auth/v1):
# JWT_ISSUER="https://[YOUR-PROJECT-REF].supabase.co/auth/v1"

# --- CORS Configuration ---
# Comma-separated list of allowed origins for browser clients
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# --- Database Configuration (PostgreSQL ONLY) ---
# Async PostgreSQL connection string with asyncpg driver.
# Local Docker or Postgres example:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sharespace"
# Hosted Supabase session-pooler example:
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require"

# Database Connection Pool Tuning (session pooler recommended limits)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=10.0
DB_ENFORCE_APP_ROLE=true

# --- Private Evidence Storage (Supabase Storage) ---
# Enables condition photograph uploads during check-in and return handovers
EVIDENCE_STORAGE_PROVIDER="supabase"
EVIDENCE_STORAGE_BUCKET="sharespace-evidence"
SUPABASE_BUCKET_NAME="sharespace-evidence"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key-from-dashboard"
# SUPABASE_ANON_KEY="replace-with-your-supabase-anon-key-from-dashboard"
