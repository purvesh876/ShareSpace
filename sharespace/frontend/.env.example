# ==============================================================================
# ShareSpace Frontend Environment Configuration Example
# Copy this file to frontend/.env in local development.
# Only VITE_* prefixed variables are exposed to the browser bundle.
# ==============================================================================

# FastAPI Backend Service Base URL
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# --- Supabase Auth Client Configuration ---
# Only expose your project URL and public publishable/anon key!
# NEVER put your database password, JWT secret, or service_role key here!
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Enable local development demo personas (restricted to dev/test environments)
VITE_ENABLE_DEMO_PERSONAS=true
