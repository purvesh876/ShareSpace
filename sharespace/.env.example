# ==============================================================================
# ShareSpace Root Environment Configuration Example
# Copy this file to .env in local development. Never commit real .env files to Git!
# ==============================================================================

# --- Backend Configuration (FastAPI) ---
APP_NAME="ShareSpace API"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-random-secure-secret-key-in-production"
# Supabase Auth Configuration (JWT verification)
# SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# JWT_ALGORITHM="HS256"
# SUPABASE_JWT_SECRET="replace-with-your-supabase-jwt-secret-from-dashboard"
# SUPABASE_JWT_PUBLIC_KEY=""
# JWT_AUDIENCE="authenticated"
# JWT_ISSUER="https://[YOUR-PROJECT-REF].supabase.co/auth/v1"

# CORS: Comma-separated list of allowed origins for browser clients
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# Database: PostgreSQL ONLY (SQLite is not supported in ShareSpace)
# Local Docker or Postgres example:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sharespace"
# Hosted (e.g. Supabase) example:
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional Database Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=10.0
DB_ENFORCE_APP_ROLE=true

# --- Private Evidence Storage (Supabase Storage) ---
# EVIDENCE_STORAGE_PROVIDER="supabase"
# EVIDENCE_STORAGE_BUCKET="sharespace-evidence"
# SUPABASE_BUCKET_NAME="sharespace-evidence"
# SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key-from-dashboard"

# --- Frontend Configuration (Vite) ---
# The base URL pointing to the FastAPI backend service
VITE_API_BASE_URL="http://localhost:8000/api/v1"
# Supabase Client Configuration (Safe for browser / anon key ONLY)
# Never expose database credentials, JWT secret, or service-role keys here!
# VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
# VITE_ENABLE_DEMO_PERSONAS=true
